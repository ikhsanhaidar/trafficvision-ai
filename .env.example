# Generate .env with the command in README.md (Quick start).
# Never commit .env. Password hash and random secrets are generated locally.
POSTGRES_PASSWORD=
TV_SECRET_KEY=
TV_ADMIN_USERNAME=admin
TV_ADMIN_PASSWORD_HASH=
# If APP_PORT changes, update both localhost origins below to the same port.
TV_ALLOWED_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:5173","http://127.0.0.1:5173"]
TV_COOKIE_SECURE=false
TV_LEASE_SECONDS=120
TV_GPU_ENABLED=false
TV_DATABASE_URL=postgresql+psycopg://trafficvision:replace-me@localhost:5432/trafficvision
TV_REDIS_URL=redis://localhost:6379/0
TV_STORAGE_ROOT=./data/app
MODEL_CHECKPOINT=models/yolo11n.pt
APP_PORT=8080
